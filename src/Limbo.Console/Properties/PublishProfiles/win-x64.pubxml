<?xml version="1.0" encoding="utf-8"?>
<!--
  End-user release build: bundles the .NET runtime so the app runs on machines
  without .NET installed. Output is a single Limbo.Console.exe plus
  WinDivert.dll / WinDivert64.sys and the license files next to it
  (see Limbo.Driver.csproj / Limbo.Console.csproj).

  CLI:  dotnet publish src/Limbo.Console -p:PublishProfile=win-x64
  VS:   right-click Limbo.Console > Publish > win-x64
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <!-- Keep Core/Driver .pdb files out of the end-user package. -->
    <AllowedReferenceRelatedFileExtensions>-</AllowedReferenceRelatedFileExtensions>
    <PublishDir>bin\publish\win-x64\</PublishDir>
  </PropertyGroup>
</Project>
