<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:tb="http://www.hardcodet.net/taskbar">

    <!-- System Tray Icon -->
    <tb:TaskbarIcon x:Key="LimboTrayIcon"
                    ToolTipText="Limbo - DPI Bypass Engine">
        
        <tb:TaskbarIcon.ContextMenu>
            <ContextMenu>
                <MenuItem Header="🌌 Limbo" IsEnabled="False" FontWeight="Bold"/>
                <Separator/>
                <MenuItem x:Name="TrayStartStop" Header="▶️ Start Engine"/>
                <Separator/>
                <MenuItem x:Name="TrayShow" Header="📊 Show Dashboard"/>
                <MenuItem x:Name="TraySettings" Header="⚙️ Settings"/>
                <Separator/>
                <MenuItem x:Name="TrayExit" Header="❌ Exit" Foreground="#ff6b6b"/>
            </ContextMenu>
        </tb:TaskbarIcon.ContextMenu>
    </tb:TaskbarIcon>
    
</ResourceDictionary>
