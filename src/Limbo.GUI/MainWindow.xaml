<Window x:Class="Limbo.GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Limbo - DPI Bypass Engine" 
        Height="700" Width="1000"
        MinHeight="600" MinWidth="800"
        Background="{DynamicResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" 
                      GlassFrameThickness="0" 
                      CornerRadius="12" 
                      ResizeBorderThickness="5"/>
    </WindowChrome.WindowChrome>

    <Border CornerRadius="12" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" CornerRadius="12,12,0,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0">
                        <TextBlock Text="🌌" FontSize="18" VerticalAlignment="Center"/>
                        <TextBlock Text="LIMBO" FontSize="14" FontWeight="Bold" 
                                   Foreground="{DynamicResource TextBrush}" 
                                   Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" 
                                WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="MinimizeBtn" Content="─" Width="45" Height="40" 
                                Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}"
                                BorderThickness="0" FontSize="14" Click="MinimizeBtn_Click"/>
                        <Button x:Name="MaximizeBtn" Content="□" Width="45" Height="40" 
                                Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}"
                                BorderThickness="0" FontSize="14" Click="MaximizeBtn_Click"/>
                        <Button x:Name="CloseBtn" Content="✕" Width="45" Height="40" 
                                Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}"
                                BorderThickness="0" FontSize="14" Click="CloseBtn_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content -->
            <Grid Grid.Row="1" Margin="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,15,0">
                    <StackPanel>
                        <!-- Main Toggle -->
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="Engine Status" FontSize="12" 
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="StatusText" Text="INACTIVE" FontSize="18" 
                                               FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock x:Name="StatusSubtext" Text="Click toggle to start" 
                                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                                <ToggleButton x:Name="EngineToggle" Grid.Column="1" 
                                              Style="{StaticResource ToggleButtonStyle}"
                                              Checked="EngineToggle_Checked" 
                                              Unchecked="EngineToggle_Unchecked"/>
                            </Grid>
                        </StackPanel>

                        <Separator Background="{DynamicResource BorderBrush}" Margin="0,0,0,20"/>

                        <!-- Stats -->
                        <TextBlock Text="Live Statistics" FontSize="12" 
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,15"/>
                        
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="Packets" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="PacketsText" Text="0" FontSize="24" 
                                       FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="Matched" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="MatchedText" Text="0" FontSize="24" 
                                       FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="Modified" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="ModifiedText" Text="0" FontSize="24" 
                                       FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="Data Processed" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="DataText" Text="0 B" FontSize="24" 
                                       FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                        </StackPanel>

                        <Separator Background="{DynamicResource BorderBrush}" Margin="0,10,0,15"/>

                        <!-- Bandwidth -->
                        <TextBlock Text="Bandwidth" FontSize="12" 
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="↓ Download" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock x:Name="DownloadRateText" Text="0 B/s" FontSize="16" 
                                           FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="↑ Upload" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock x:Name="UploadRateText" Text="0 B/s" FontSize="16" 
                                           FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Peak ↓" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock x:Name="PeakDownloadText" Text="0 B/s" FontSize="12" 
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Peak ↑" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock x:Name="PeakUploadText" Text="0 B/s" FontSize="12" 
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Main Panel -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Tabs -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                        <RadioButton x:Name="ProfilesTab" Content="Profiles" IsChecked="True"
                                     Style="{StaticResource TabStyle}"
                                     Checked="Tab_Checked"/>
                        <RadioButton x:Name="LogsTab" Content="Logs"
                                     Style="{StaticResource TabStyle}"
                                     Checked="Tab_Checked"/>
                        <RadioButton x:Name="SettingsTab" Content="Settings"
                                     Style="{StaticResource TabStyle}"
                                     Checked="Tab_Checked"/>
                    </StackPanel>

                    <!-- Content Area -->
                    <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                        <Grid>
                            <!-- Profiles Panel -->
                            <Grid x:Name="ProfilesPanel">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <TextBlock Text="Domain Profiles" FontSize="16" FontWeight="SemiBold" 
                                            Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                            
                                    <Button Grid.Column="1" Content="📡 Radar Import" 
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Margin="0,0,8,0"
                                            ToolTip="Import raw domains to Auto-Blacklist.txt"
                                            Click="ImportRadar_Click"/>
                                    <Button Grid.Column="2" Content="📡 Radar Export" 
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Margin="0,0,20,0" 
                                            ToolTip="Export auto-detected blocked domains"
                                            Click="ExportRadar_Click"/>

                                    <Button Grid.Column="3" Content="📥 Import" 
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Margin="0,0,8,0"
                                            Click="ImportProfiles_Click"/>
                                    <Button Grid.Column="4" Content="📤 Export" 
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Margin="0,0,8,0"
                                            Click="ExportProfiles_Click"/>
                                    <Button Grid.Column="5" Content="+ Add Profile" 
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Click="AddProfile_Click"/>
                                </Grid>

                                <ListBox x:Name="ProfilesList" Grid.Row="1">
                                    <ListBox.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="✏️ Edit Profile" Click="EditProfile_Click"/>
                                            <MenuItem Header="📤 Export This Profile" Click="ExportSingleProfile_Click"/>
                                            <Separator/>
                                            <MenuItem Header="🗑️ Delete Profile" Click="DeleteProfileMenu_Click"
                                                      Foreground="{DynamicResource ErrorBrush}"/>
                                        </ContextMenu>
                                    </ListBox.ContextMenu>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Domain}" FontSize="14" 
                                                               Foreground="{DynamicResource TextBrush}"/>
                                                    <TextBlock Text="{Binding Method}" FontSize="11" 
                                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding FragmentSize, StringFormat='Frag: {0}'}" 
                                                           FontSize="12" Foreground="{DynamicResource PrimaryBrush}"
                                                           VerticalAlignment="Center" Margin="10,0"/>
                                                <Button Grid.Column="2" Content="✕" 
                                                        Background="Transparent" 
                                                        Foreground="{DynamicResource ErrorBrush}"
                                                        BorderThickness="0" Padding="8,4"
                                                        Click="DeleteProfile_Click"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>

                            <!-- Logs Panel -->
                            <Grid x:Name="LogsPanel" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <TextBlock Text="Activity Log" FontSize="16" FontWeight="SemiBold" 
                                               Foreground="{DynamicResource TextBrush}"/>
                                    <Button Content="Clear" HorizontalAlignment="Right"
                                            Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}"
                                            BorderThickness="0" Click="ClearLogs_Click"/>
                                </Grid>

                                <RichTextBox x:Name="LogsBox" Grid.Row="1" 
                                             IsReadOnly="True" 
                                             Background="Transparent" 
                                             Foreground="{DynamicResource TextSecondaryBrush}"
                                             BorderThickness="0"
                                             FontFamily="Consolas" 
                                             FontSize="12"
                                             VerticalScrollBarVisibility="Auto">
                                    <FlowDocument>
                                        <Paragraph Margin="0">
                                            <Run Text="Limbo Engine Ready..."/>
                                        </Paragraph>
                                    </FlowDocument>
                                </RichTextBox>
                            </Grid>

                            <!-- Settings Panel -->
                            <Grid x:Name="SettingsPanel" Visibility="Collapsed">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="Settings" FontSize="16" FontWeight="SemiBold" 
                                                   Foreground="{DynamicResource TextBrush}" Margin="0,0,0,20"/>

                                        <!-- Appearance Settings -->
                                        <TextBlock Text="APPEARANCE" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10"/>
                                        
                                        <Grid Margin="0,0,0,20">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Theme" 
                                                           Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Text="Choose light, dark, or follow system" 
                                                           FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                            <ComboBox x:Name="ThemeCombo" Grid.Column="1" Width="130"
                                                      Background="{DynamicResource SurfaceLightBrush}"
                                                      Foreground="{DynamicResource TextBrush}"
                                                      SelectionChanged="ThemeCombo_SelectionChanged">
                                                <ComboBoxItem Content="System" Tag="System"/>
                                                <ComboBoxItem Content="Light" Tag="Light"/>
                                                <ComboBoxItem Content="Dark" Tag="Dark"/>
                                            </ComboBox>
                                        </Grid>

                                        <!-- DNS Settings -->
                                        <TextBlock Text="DNS SETTINGS" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10"/>
                                        
                                        <Grid Margin="0,0,0,15">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Enable DNS over HTTPS" 
                                                       Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                            <ToggleButton x:Name="DoHToggle" Grid.Column="1" 
                                                          Style="{StaticResource ToggleButtonStyle}"/>
                                        </Grid>

                                        <StackPanel Margin="0,0,0,20">
                                            <TextBlock Text="DoH Server" FontSize="11" 
                                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                                            <TextBox x:Name="DoHServerBox" Text="https://1.1.1.1/dns-query"/>
                                        </StackPanel>

                                        <!-- Application Settings -->
                                        <TextBlock Text="APPLICATION SETTINGS" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10"/>
                                        
                                        <Grid Margin="0,0,0,15">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Close to System Tray" 
                                                           Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Text="Keep running in background when closing" 
                                                           FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                            <ToggleButton x:Name="CloseToTrayToggle" Grid.Column="1" 
                                                          Style="{StaticResource ToggleButtonStyle}"
                                                          IsChecked="True"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,15">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Minimize to System Tray" 
                                                           Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Text="Hide from taskbar when minimized" 
                                                           FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                            <ToggleButton x:Name="MinimizeToTrayToggle" Grid.Column="1" 
                                                          Style="{StaticResource ToggleButtonStyle}"
                                                          IsChecked="True"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,20">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Start Minimized" 
                                                           Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Text="Start application in system tray" 
                                                           FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                            <ToggleButton x:Name="StartMinimizedToggle" Grid.Column="1" 
                                                          Style="{StaticResource ToggleButtonStyle}"/>
                                        </Grid>

                                        <Button Content="Save Settings" 
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                HorizontalAlignment="Left"
                                                Click="SaveSettings_Click"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Quick Actions -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,15,0,0">
                        <Button Content="🔍 Calibrate Domain" 
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="0,0,10,0"
                                Click="Calibrate_Click"/>
                        <Button Content="🧪 Test Connection" 
                                Style="{StaticResource SecondaryButtonStyle}"
                                FontSize="14" Padding="20,10"
                                Click="TestConnection_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
