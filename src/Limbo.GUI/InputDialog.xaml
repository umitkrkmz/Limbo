<Window x:Class="Limbo.GUI.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Input" 
        Height="200" Width="400"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize">

    <Border CornerRadius="12" Background="{DynamicResource SurfaceBrush}" 
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <TextBlock x:Name="TitleText" Text="Input" FontSize="18" FontWeight="SemiBold" 
                       Foreground="{DynamicResource TextBrush}" Margin="0,0,0,15"/>

            <!-- Input -->
            <StackPanel Grid.Row="1">
                <TextBlock x:Name="PromptText" Text="Enter value:" FontSize="12" 
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                <TextBox x:Name="InputBox" Margin="0,0,0,15"/>
            </StackPanel>

            <!-- Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" 
                        Style="{StaticResource SecondaryButtonStyle}"
                        Padding="20,10" Margin="0,0,10,0"
                        Click="Cancel_Click"/>
                <Button Content="OK" 
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="OK_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
